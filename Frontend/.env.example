# Copy to Frontend/.env. Vite bakes these into the bundle at build time, so after
# changing one, restart `npm run dev` (or rebuild). Anything here is visible to
# anyone who loads the site - never put a secret in a VITE_ variable.

# Base URL of the API, no trailing slash. Local: the API's launch profile listens
# on http://localhost:5176 (also what docker-compose publishes).
VITE_API_BASE_URL=http://localhost:5176

# The Telegram bot's @username without the "@" (from BotFather). Optional: leave
# empty and the "Notify me on Telegram" button is hidden.
VITE_TELEGRAM_BOT_USERNAME=
