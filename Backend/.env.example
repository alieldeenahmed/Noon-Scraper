# Every setting the backend reads. Copy to Backend/.env if you use a tool that loads
# .env files (docker compose --env-file Backend/.env, or your shell). .NET itself does
# NOT read .env files: for `dotnet run` set these as environment variables, or store the
# secrets with `dotnet user-secrets` (see Backend/README.md).
#
# Values below marked DEV-ONLY are local defaults for the docker-compose database and
# are not secrets. Anything marked SECRET must never be committed; leave it empty here.
#
# Nested .NET keys use "__" as the separator in environment variables
# (ConnectionStrings__DefaultConnection == ConnectionStrings:DefaultConnection).
# Some hosts (Back4app) reject "__", so each key below also has a flat alias the code
# accepts - the flat alias is noted next to it.

# ---- Database -------------------------------------------------------------
# Used by docker-compose.yml to create the local PostgreSQL container. DEV-ONLY.
POSTGRES_DB=noonscraper
POSTGRES_USER=noon
POSTGRES_PASSWORD=noon_dev_only
POSTGRES_PORT=5432

# Npgsql connection string for the API, the crawler and the seed tool.
# Flat alias: DATABASE.  DEV-ONLY value matching the compose database above.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=noonscraper;Username=noon;Password=noon_dev_only

# ---- GitHub Actions dispatch (API -> crawler) -------------------------------
# Fine-grained personal access token with "Actions: write" on this one repository.
# Without it the API still runs; "crawl this product" / "check now" requests are
# recorded as failed at stage "dispatch". Flat alias: GITHUB_DISPATCH_TOKEN. SECRET.
GitHubDispatch__Token=

# ---- Telegram (optional) ----------------------------------------------------
# Bot token from @BotFather. Without it notifications are skipped. SECRET.
# Flat alias: TELEGRAM_BOT_TOKEN
Telegram__BotToken=
# Shared secret Telegram sends with every webhook call. Outside the Development
# environment the webhook refuses all requests until this is set. SECRET.
# Flat alias: TELEGRAM_WEBHOOK_SECRET
Telegram__WebhookSecret=

# ---- Rate limiting (in-process; defaults shown, all optional) ----------------
# Requests per minute, fixed window.
RateLimiting__GlobalPerMinute=300
RateLimiting__TotalPerMinute=3000
# Endpoints that start a GitHub Actions run (submit a product, check now).
RateLimiting__DispatchPerMinute=5
RateLimiting__DispatchTotalPerMinute=30

# ---- Database-backed budgets (API; defaults shown, all optional) -------------
Jobs__MaxDispatchesPerHour=30
Jobs__MaxNewProductsPerHour=20
Jobs__MaxUserProducts=500
# A Pending/Running request older than this is treated as dead.
Jobs__StaleAfterMinutes=15

# ---- Proxy handling (API; optional) ------------------------------------------
# Number of trusted reverse-proxy hops for X-Forwarded-For. Leave unset unless you
# know the depth of the proxy chain in front of the API.
# Network__ForwardLimit=1

# ---- Crawler (optional; defaults shown) ---------------------------------------
Crawl__MaxAttempts=2
# Format: hh:mm:ss
Crawl__RetryDelay=00:00:03
# Politeness: the least time between the end of one page visit and the start of the next
# in the scheduled crawl (category pages, then user-added product pages). Time already
# spent between visits counts towards it. Not applied before the first visit, and not to
# the single-page jobs (crawl-product, check-now). 00:00:00 turns it off. A pause that
# would run past Crawl__Budget is not taken; the run stops starting work instead.
# Format: hh:mm:ss (fractions allowed, e.g. 00:00:02.500)
Crawl__DelayBetweenPages=00:00:03
Crawl__Budget=00:15:00
Crawl__MaxFailureRate=0.2
Crawl__StaleAfter=00:15:00

# ---- Environment ---------------------------------------------------------------
# Development trusts any localhost origin for CORS and leaves the Telegram webhook
# open. Any other value allows only the deployed frontend origin.
ASPNETCORE_ENVIRONMENT=Development
